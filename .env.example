# Copy this file to .env and set your own path.
# Where the deck notes (and their Attachments/ images) get written —
# point it at a folder inside your Obsidian vault.
VAULT_OUTPUT_DIR=C:/path/to/your/vault/MTG

# Optional: your owned-cards list for the "Cards to Buy" section.
# Defaults to _Collection.md inside VAULT_OUTPUT_DIR.
#COLLECTION_FILE=C:/path/to/your/vault/MTG/_Collection.md

# Optional: minimum card condition for ManaPool prices.
# any = cheapest listing in any condition, lp = Lightly Played or better
# (default), nm = Near Mint only.
#MANAPOOL_CONDITION=lp
